# Slack Bot Configuration (Socket Mode)
SLACK_BOT_TOKEN=xoxb-your-bot-token-here
SLACK_APP_TOKEN=xapp-your-app-level-token-here
SLACK_SIGNING_SECRET=your-slack-signing-secret-here

# LLM Provider API Keys
GROQ_API_KEY=gsk_your_groq_api_key_here
OPENROUTER_API_KEY=sk-or-your-openrouter_api_key_here

# Runtime Mode: 'mock' for deterministic offline tests/fixtures, 'live' for API routing
LLM_MODE=mock

# Database & Vector Store Settings
DATABASE_URL=sqlite:///./proposals.db
CHROMA_PERSIST_DIR=./chroma_db
EMBEDDING_MODEL_NAME=BAAI/bge-small-en-v1.5

# Server & Logging
HOST=0.0.0.0
PORT=8000
ENVIRONMENT=development
LOG_LEVEL=INFO

